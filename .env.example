# —— 后端选择（核心：云端先出效果，本地是护城河）——
STT_BACKEND=text          # text | cloud | local
TTS_BACKEND=none          # none | cloud | local

# —— LLM：DeepSeek 云 或 本地 llama.cpp 的 OpenAI 兼容端点 ——
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
DEEPSEEK_API_KEY=sk-...

# —— 本地后端（可选，切本地时用）——
# 本地 LLM 示例：llama-server -m qwen2.5-3b-instruct-q4_k_m.gguf --port 8080
#   LLM_BASE_URL=http://localhost:8080/v1   LLM_MODEL=local
WHISPER_BIN=whisper-cli
WHISPER_MODEL=models/ggml-base.bin
PIPER_MODEL=en_US-lessac-medium.onnx

# —— 安全 ——
DRY_RUN=1
SERVICE_ALLOW=agent,camera,collector,sensor
RECORD_SECONDS=4
